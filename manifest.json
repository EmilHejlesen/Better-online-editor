{
  "manifest_version": 3,
  "name": "Input Monitor",
  "version": "1.0",
  "description": "Monitors what the user types and performs an action on a key combo.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
